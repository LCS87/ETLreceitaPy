# Banco de Dados
DB_HOST=localhost
DB_PORT=5433
DB_NAME=receita_db
DB_USER=seu_usuario
DB_PASS=sua_senha

# Performance — ajustar conforme hardware
CHUNK_SIZE=500000
MAX_DOWNLOADS=8
MAX_WORKERS=10
POSTGRES_POOL_SIZE=16
POSTGRES_MAX_OVERFLOW=32

# Monitoramento
PROMETHEUS_PORT=8000

# Receita Federal
RECEITA_BASE_URL=https://arquivos.receitafederal.gov.br/index.php/s/YggdBLfdninEJX9
RECEITA_TARGET_DIR=2026-03

# Segurança da API REST
# Deixe vazio para desativar autenticação (modo desenvolvimento)
# Em produção, defina uma chave forte e secreta
API_KEY=

# Origens permitidas para CORS (separadas por vírgula)
# Ex.: http://localhost:3000,https://meu-frontend.com
ALLOWED_ORIGINS=*
